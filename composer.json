{
  "name": "fiskhandlarn/bajsmackans-dag",
  "description": "\"Holger var full på barnens dag.\"",
  "authors": [
    {
      "name": "fiskhandlarn",
      "email": "fiskhandlarn@gmail.com"
    },
    {
      "name": "tz",
      "email": "nahkampf@gmail.com"
    }
  ],
  "license": "WTFPL",
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.1.0"
    }
  },
  "require": {
    "php": "^8.1.0",
    "ext-curl": "*",
    "guzzlehttp/guzzle": "^8.2.0",
    "nesbot/carbon": "^3.14.2",
    "vlucas/phpdotenv": "^5.7.0"
  },
  "require-dev": {
    "armin/editorconfig-cli": "^1.8.1",
    "codeception/codeception": "^5.2.2",
    "codeception/module-cli": "^2.0.1",
    "friendsofphp/php-cs-fixer": "^3.95.27",
    "seld/jsonlint": "^1.12.1",
    "symfony/var-dumper": "^6.4.48"
  },
  "scripts": {
    "lint:php": [
      "find . -type f -name '*.php' -print0 | xargs -0 -n1 -P4 php -l -n"
    ],
    "lint:json": [
      "@php -r \"require 'vendor/autoload.php'; Dotenv\\Dotenv::createUnsafeImmutable('.')->load(); exit(fwrite(STDERR, (new Seld\\JsonLint\\JsonParser())->lint(file_get_contents(getenv('DATA_JSON')))?->getMessage() ?? '') ? 1 : 0);\""
    ],
    "lint:style": [
      "php-cs-fixer fix --dry-run --diff --show-progress=none",
      "ec --git-only --no-progress"
    ],
    "fix:style": [
      "php-cs-fixer fix --show-progress=none",
      "ec --git-only --no-progress --fix"
    ],
    "test": [
      "codecept run"
    ],
    "app": [
      "php index.php"
    ],
    "post-install-cmd": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  }
}
